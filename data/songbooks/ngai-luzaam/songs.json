  "songs": [
    {
      "id": "ngai-luzaam-200",
      "number": 1,
      "sourceNumber": 200,
      "title": "Khristmas thingbang, Khristmas thingbang",
      "titleRongmei": "Khristmas thingbang, Khristmas thingbang",
      "search": {
        "keywords": [
          "Christmas",
          "Khristmas",
          "seasonal",
          "No. 200"
        ]
      },
      "content": {
        "sections": [
          {
            "type": "verse",
            "label": "Verse 1",
            "lines": [
              "Khristmas thingbang, Khristmas thingbang!",
              "Ndiak ring gaimei thingbang;",
              "Kanui diakchui laophunsuan khou",
              "Tingsei gan rui ngam puni cho;",
              "Khristmas thingbang, Khristmas thingbang",
              "Ndiak ring gaimei thingbang."
            ]
          },
          {
            "type": "verse",
            "label": "Verse 2",
            "lines": [
              "Khristmas thingbang, Khristmas thingbang!",
              "Alung khou lu tisuan lou;",
              "Nang thaumei riu gaanchuang riu kum",
              "Chrinmei riu kandi khou tikei;",
              "Khristmas thingbang, Khristmas thingbang!",
              "Alung khou lu tisuan lou."
            ]
          },
          {
            "type": "verse",
            "label": "Verse 3",
            "lines": [
              "Khristmas thingbang, Khristmas thingbang!",
              "Raguang khou rui nang kei e;",
              "Zian lou mei Raguang tuang kheiliak",
              "Kau thang rui di khou diukei e;",
              "Khristmas thingbang, Khristmas thingbang!",
              "Raguang khou rui nang kei e."
            ]
          },
          {
            "type": "verse",
            "label": "Verse 4",
            "lines": [
              "Khristmas thingbang, Khristmas thingbang!",
              "Raguang e tumei dinlou;",
              "Aniu rui lanu khang chinlou",
              "Raguang ta thukna lumbam khang",
              "Khristmas thingbang, Khristmas thingbang!",
              "Raguang e tumei dinlou."
            ]
          }
        ]
      }
    },
    {
      "id": "ngai-luzaam-201",
      "number": 2,
      "sourceNumber": 201,
      "title": "He neihla Christmas",
      "titleRongmei": "He neihla Christmas",
      "search": {
        "keywords": [
          "Christmas",
          "Khristmas",
          "No. 201"
        ]
      },
      "content": {
        "sections": [
          {
            "type": "verse",
            "label": "Verse 1",
            "lines": [
              "He neila khrismas mun puang gaimei tuai the",
              "Tingkum man nimei thei laikan the;",
              "Kaban tei sin na nu mak na tat kan the",
              "He neila christmas."
            ]
          },
          {
            "type": "chorus",
            "label": "Chorus",
            "lines": [
              "Nkhuan no, nkhuan no nzian na nkhuan no",
              "Arup arian nzian mei nun",
              "Ntam mei hei neila christmas."
            ]
          },
          {
            "type": "verse",
            "label": "Verse 2",
            "lines": [
              "He Raguang ntam kan nimei nzian e",
              "Nei khat na sini bam lakna cho.",
              "Aniu khang gaimei munpuang tei tuai kan the;",
              "He neila Christmas."
            ]
          },
          {
            "type": "verse",
            "label": "Verse 3",
            "lines": [
              "Keidat nimei ta hou khang tei cham dan o",
              "Nkhuan bam o tingkao than mei ta,",
              "Suaihiam kathan pui tuang guaini lapuni;",
              "He neihla Christmas."
            ]
          },
          {
            "type": "verse",
            "label": "Verse 4",
            "lines": [
              "Tingkao kandi ganloumei tuang tei kum na",
              "Ntam mak nu makge poubaomei;",
              "Nang zanc ta saan na heikhou tei thuanc bam ni,",
              "He! neihla Christmas."
            ]
          }
        ]
      }
    },
    {
      "id": "ngai-luzaam-202",
      "number": 3,
      "sourceNumber": 202,
      "title": "Rim-rimpui zingbang, thanmei zingbang khou",
      "titleRongmei": "Rim-rimpui zingbang, thanmei zingbang khou",
      "search": {
        "keywords": [
          "Christmas",
          "Bethlehem",
          "No. 202"
        ]
      },
      "content": {
        "sections": [
          {
            "type": "verse",
            "label": "Verse 1",
            "lines": [
              "Rim-rimpui zingbang, thanmei zingbang khou",
              "Banchra nun khuan le kaniu tiguang e,",
              "Khou tei thau the, lauziu gaangmei;",
              "Bethlehem khou puan. [3]"
            ]
          },
          {
            "type": "verse",
            "label": "Verse 2",
            "lines": [
              "Keikhuang khou ziloumei ta hou puni",
              "Pouta souriu khang nangniu tatthau tho;",
              "Poubaomei kahim dai kandiu,",
              "Di khou chuzaengmei nai kandiu",
              "Khrista puanlouna. [3]"
            ]
          },
          {
            "type": "verse",
            "label": "Verse 3",
            "lines": [
              "Lauziu gaengmei Bethlehem thang tat the’",
              "Khou tei kaniu Jisu ta ariu the;",
              "Din kasuaklou tina guangmei",
              "Duan gaidiu pouta souriumei,",
              "Tao kamei guanglouna. [3]"
            ]
          },
          {
            "type": "verse",
            "label": "Verse 4",
            "lines": [
              "Guang Jisu Khrista ta guang kalum the",
              "Tingkao banchra guai neila lusuan e;",
              "Poubaomei kahim dai kandiu",
              "Di khou chuzaengmei nai kandiu,",
              "Khrista puanlou na. [3]"
            ]
          }
        ]
      }
    },
    {
      "id": "ngai-luzaam-254",
      "number": 4,
      "sourceNumber": 254,
      "title": "He kaidai launa Bethlehem",
      "titleRongmei": "He kaidai launa Bethlehem",
      "search": {
        "keywords": [
          "Christmas",
          "Bethlehem",
          "No. 254"
        ]
      },
      "content": {
        "sections": [
          {
            "type": "verse",
            "label": "Verse 1",
            "lines": [
              "He kaidai launa Bethlehem",
              "Nang zip rim-rim bam e!",
              "Nang zip theimang mang bam khou tei",
              "Gaanchuang rui tatbam e;",
              "Zinghmei nang chaeng guai khou",
              "Tingsaengzaeng riu gaan bam e;",
              "Tingsaengna machunh guangmei tei",
              "‘Seih zingbang ariu the."
            ]
          },
          {
            "type": "verse",
            "label": "Verse 2",
            "lines": [
              "Mary khou rui Khrista puan the;",
              "Meiguai zipri bam khou,",
              "Ch’rinmei ramzian tei zau lana",
              "Baanch’ra guai rih gaanbam.",
              "Laukhuan gaanphiu guai rui",
              "Thanmei ngana puanhmei ta!",
              "Kau na Raguang ta thuan na suan,",
              "Dih khou zaengmei nai diu."
            ]
          },
          {
            "type": "verse",
            "label": "Verse 3",
            "lines": [
              "Adih rim-rimna charinmei",
              "Kaipat tei tilou cho!",
              "Raguang rui maansei guai lung khou",
              "Tingkau suaihiam tilou.",
              "Paap kandi khou Kamei;",
              "Guangmei chu mak khuan sini,",
              "Kata laloumei lung guai khou,",
              "Khrista rui gut bam e."
            ]
          },
          {
            "type": "verse",
            "label": "Verse 4",
            "lines": [
              "Nthanmei Bethlehem ngana,",
              "Aniu khou keilou o;",
              "‘Niu paap la ganna gut bam o",
              "‘Niu khou ‘seih puanlou o,",
              "Baanch’ra nun phung guangmei",
              "Gaicham tei aniu chu e",
              "Guangna ‘niu ta bamduanghlou o,",
              "‘Niu pou Immanuel."
            ]
          }
        ]
      }
    },
    {
      "id": "ngai-luzaam-255",
      "number": 5,
      "sourceNumber": 255,
      "title": "Reinungh Noel baanch’ra sa e",
      "titleRongmei": "Reinungh Noel baanch’ra sa e",
      "search": {
        "keywords": [
          "Noel",
          "Christmas",
          "Bethlehem",
          "No. 255"
        ]
      },
      "content": {
        "sections": [
          {
            "type": "verse",
            "label": "Verse 1",
            "lines": [
              "Reinungh Noel baanch’ra sa e",
              "Lauziu gaenghmei nun lau khou bam khou;",
              "Lauziu gaeng bammei laupuk khou,",
              "Nchumei tingsei zingbang khou."
            ]
          },
          {
            "type": "chorus",
            "label": "Chorus",
            "lines": [
              "Puan the, puan the,",
              "Puan the, puan the;",
              "Puanhmei tei Israel Guang e."
            ]
          },
          {
            "type": "verse",
            "label": "Verse 2",
            "lines": [
              "Kaniu zauku neihpat biak thang",
              "Gaanphiu akhat gaan bammei hou the,",
              "Kandi khou tei gaanchui na gaan,",
              "Zingbang ni, kalaan ni gaan e."
            ]
          },
          {
            "type": "verse",
            "label": "Verse 3",
            "lines": [
              "Gaanphiu riu khou dih duh thang rui,",
              "Ningtingmei gaanthumh Guangh ta phu khang;",
              "Gaanchuang rui zailoupui bamthuih,",
              "Kaniu suina nzuan guang e."
            ]
          },
          {
            "type": "verse",
            "label": "Verse 4",
            "lines": [
              "Gaanphiu rui neihkei le nliang,",
              "Bethlehem rukhou guangtang pukhou,",
              "Khou tei dingna nthaeklou the,",
              "Jisu zip bammei rukhou tei."
            ]
          },
          {
            "type": "verse",
            "label": "Verse 5",
            "lines": [
              "Ningtingmei nun gaanthumh tei rui,",
              "Champouh na khuksunna kalum the,",
              "Kahu khou tei katlou kan the,",
              "Kaniu tuang kachaek, mundui, agau."
            ]
          }
        ]
      }
    },
    {
      "id": "ngai-luzaam-256",
      "number": 6,
      "sourceNumber": 256,
      "title": "Neihpat thang Guangh aniu gaanthumh",
      "titleRongmei": "Neihpat thang Guangh aniu gaanthumh",
      "search": {
        "keywords": [
          "Christmas",
          "Bethlehem",
          "No. 256"
        ]
      },
      "content": {
        "sections": [
          {
            "type": "verse",
            "label": "Verse 1",
            "lines": [
              "Neihpat thang Guangh aniu gaanthumh;",
              "Kaipat phungna nzuanh guang e",
              "Chingh, ‘zaeng, duithuak, laupuk, kaanna",
              "Gaanchuang ta suiguang e."
            ]
          },
          {
            "type": "chorus",
            "label": "Chorus",
            "lines": [
              "He, ch’rinmei zingbang gaanchuangna,",
              "Guangh ramgai gaanhmei gaanchuang,",
              "Neihkei biak aniu ta zaina,",
              "Gaanchuimei khou zailou o."
            ]
          },
          {
            "type": "verse",
            "label": "Verse 2",
            "lines": [
              "Guangh ‘khat puan e Bethlehem khou,",
              "Ai kakhang kachaek phung guang e,",
              "Tingsaengzaengna taekdat makna",
              "‘Niu rukhou guanghtu khang,"
            ]
          },
          {
            "type": "verse",
            "label": "Verse 3",
            "lines": [
              "Munrim gaimei ai phung guang e;",
              "ARaguang khang katlou diu khang;",
              "Meiguai rui thauna thuanku o,",
              "Raguang ta kalum o."
            ]
          },
          {
            "type": "verse",
            "label": "Verse 4",
            "lines": [
              "Nkhumei agau rim hei rui",
              "Zinghmei guang nimei dinh tuang e:",
              "Rianrana, zei keina, theina,",
              "Tarou khou phup puni."
            ]
          }
        ]
      }
    }
  ]
}
